
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Bingo</title>
</head>
<body>

    <section class="menu-cubes">
        <!-- <h2 class="logo">BINGO</h2> -->
        <div class="logo">
            <h2> BINGO </h2>
        </div>
    <div class="container">
        
        
        <div class="button">
            <div class="box_shadow"></div>
            <span>Home</span>
            <div class="menuBox">
                <div class="box_face box_face_front"><a href="/"></a><i class="fa-solid fa-house"></i></div>
                <div class="box_face box_face_right"></div>
                <div class="box_face box_face_back"></div>
                <div class="box_face box_face_left"></div>
                <div class="box_face box_face_top"></div>
            </div>
        </div>
    
        <div class="button">
            <div class="box_shadow"></div>
            <span>Lobby</span>
            <div class="menuBox">
                <div class="box_face box_face_front"><a href="/"></a><i class="fa-solid fa-dice-d20"></i></ion-icon></div>
                <div class="box_face box_face_right"></div>
                <div class="box_face box_face_back"></div>
                <div class="box_face box_face_left"></div>
                <div class="box_face box_face_top"></div>
            </div>
        </div>
    
        <div class="button">
            <div class="box_shadow"></div>
            <span>Profile</span>
            <div class="menuBox">
                <div class="box_face box_face_front"><a href="/"></a><i class="fa-solid fa-user"></i></ion-icon></div>
                <div class="box_face box_face_right"></div>
                <div class="box_face box_face_back"></div>
                <div class="box_face box_face_left"></div>
                <div class="box_face box_face_top"></div>
            </div>
        </div>
    
        <div class="button">
            <div class="box_shadow"></div>
            <span>Chat</span>
            <div class="menuBox">
                <div class="box_face box_face_front"><i class="fa-brands fa-rocketchat"></i></div>
                <div class="box_face box_face_right"></div>
                <div class="box_face box_face_back"></div>
                <div class="box_face box_face_left"></div>
                <div class="box_face box_face_top"></div>
            </div>
        </div>
    
        <div class="button">
            <div class="box_shadow"></div>
            <span>SignIn</span>
            <div class="menuBox">
                <div class="box_face box_face_front">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </div>
                <div class="box_face box_face_right"></div>
                <div class="box_face box_face_back"></div>
                <div class="box_face box_face_left"></div>
                <div class="box_face box_face_top"></div>
            </div>
        </div>
    </div>
</section>
<!-- </div> -->
    <!-- menu cubes icon-->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>

